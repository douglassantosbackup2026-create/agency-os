# Edge Functions (Dashboard Supabase — não commitar valores):
# CRON_SECRET=...           — obrigatório em produção para evaluate-alerts / compute-health-scores / whatsapp-summary
# ALLOW_INSECURE_CRON_ANON=true — só desenvolvimento local; permite apikey anon se CRON_SECRET estiver vazio (nunca em prod)
# PORTAL_ALLOWED_ORIGINS=https://app.example.com — CORS do portal-data (lista separada por vírgula)
# PORTAL_RATE_LIMIT_MAX_PER_WINDOW=120
# PORTAL_RATE_LIMIT_WINDOW_MS=60000
