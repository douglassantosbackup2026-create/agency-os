# Landing pública (opcional): URL de embed de vídeo demo na homepage (ex.: link embed YouTube/Vimeo).
# VITE_LANDING_DEMO_URL=

# URL canônica do site (recomendado em produção para og:image e canonicals).
VITE_SITE_URL=https://agencyopus.live

# Funil diagnóstico Meta (homepage /, /obrigado, /gestao-obrigado, /diagnostico) — back_urls MP e links copiáveis
# Produção Worker: https://tanstack-start-app.douglaspinheirosantos94.workers.dev
# VITE_PUBLIC_SITE_URL=http://localhost:5173
# Edge (Supabase secrets): PUBLIC_SITE_URL= mesmo valor — ver docs/diagnosis-production-env.md
# Harness Meta API (dev): rota /test-meta-oauth — callback OAuth = {VITE_PUBLIC_SITE_URL}/test-meta-oauth/callback
# Opcional: VITE_META_APP_ID= (só debug; App ID real fica nas Supabase Edge Secrets)
# Segundo checkout (gestão): preferência criada pela Edge Function create-management-checkout; preço opcional também em MANAGEMENT_PRICE_CENTS na função
# Opcional WhatsApp apenas para texto da gestão (fallback 5511940485006): VITE_GESTAO_WHATSAPP_URL=https://wa.me/5511940485006
# VITE_MANAGEMENT_CTA_URL=https://example.com/contact
# VITE_DIAGNOSIS_WHATSAPP_URL=https://wa.me/5511999999999
# VITE_DIAGNOSIS_CONTACT_EMAIL=contato@seudominio.com

# Funil /gestao-trafego — preço gestão (default R$ 4.997 = 499700 centavos)
# VITE_LEAD_MANAGEMENT_PRICE_CENTS=499700 — exibição no Worker (build + runtime)
# VITE_LEAD_WAITLIST_BASE_COUNT=28 — fallback SSR/loading na copy de fila (obrigado)
# Edge Functions (Dashboard Supabase — não commitar valores):
# LEAD_MANAGEMENT_PRICE_CENTS=499700 — cobrança real MP (start/process-lead-payment)
# LEAD_WAITLIST_BASE_COUNT=28 — piso da fila exibida (base + leads new/awaiting_payment do mês)
# MANAGEMENT_MP_ITEM_TITLE=... — título opcional do item Mercado Pago (gestão)
# META_TEST_ENABLED=true — activa Edge Function meta-api-test (harness /test-meta-oauth; só localhost)
# META_TEST_OAUTH_STATE_SECRET=... — HMAC do state OAuth do harness (min. 16 chars)
# META_API_VERSION=v21.0 — opcional; versão Graph API no harness
# CRON_SECRET=...           — obrigatório em produção para evaluate-alerts / compute-health-scores / whatsapp-summary
# ALLOW_INSECURE_CRON_ANON=true — só desenvolvimento local; permite apikey anon se CRON_SECRET estiver vazio (nunca em prod)
# MERCADOPAGO_WEBHOOK_SECRET=... — obrigatório em produção (mercadopago-webhook fail-closed sem este valor)
# PORTAL_ALLOWED_ORIGINS=https://app.example.com — CORS do portal-data (lista separada por vírgula)
# PORTAL_RATE_LIMIT_MAX_PER_WINDOW=120
# PORTAL_RATE_LIMIT_WINDOW_MS=60000
# PORTAL_SLUG_MIN_LENGTH=8 — comprimento mínimo do slug no portal-data
# PORTAL_REVIEW_TOKEN_SECRET=... — HMAC para aprovar criativos no portal (min. 16 chars)
# PUBLIC_RATE_LIMIT_MAX_PER_WINDOW=30 — create-diagnosis-checkout e endpoints públicos
# SYNC_COOLDOWN_MINUTES=15 / SYNC_MAX_PER_HOUR=60 — sync-platform
# META_INSIGHTS_MAX_PAGES=20 / META_FETCH_MAX_RETRIES=3 — sync Meta
# CRON_AGENCY_BATCH_SIZE=5 — cron-dispatch-agency-jobs
# PROCESS_DIAGNOSIS_BATCH_SIZE=10 — process-diagnosis (cron */5)
# Diagnóstico IA v4-consultative (Supabase secrets):
# CLAUDE_MODEL=claude-sonnet-4-20250514 — primário consultor sênior
# DIAGNOSIS_AI_FALLBACK_MODEL=claude-sonnet-4-20250514 — retry se CLAUDE_MODEL for Haiku
# DIAGNOSIS_AI_MAX_TOKENS=6144
# DIAGNOSIS_SMALL_ACCOUNT_SPEND_BRL=3000 — fetch Meta lite abaixo deste spend 30d
# DIAGNOSIS_AI_PRIMARY=anthropic — anthropic | openai | gemini
# REPORT_SYNC_MODE=true — só dev; produção usa fila ai_jobs
# AI_JOBS_BATCH_SIZE=5 — process-ai-jobs
# WHATSAPP_SUMMARY_BATCH_SIZE=25 / WHATSAPP_EVOLUTION_THROTTLE_MS=300
# GENERATE_REPORT_COOLDOWN_MINUTES=20 / GENERATE_REPORT_MAX_PER_DAY_PER_CLIENT=12
# META_TEST_ENABLED=false — nunca true em produção pública
