{
  "name": "agency-os",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/check-prod-env.mjs && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "ops:apply-crons": "node scripts/apply-cron-jobs.mjs",
    "ops:sync-cron-secret": "node scripts/sync-cron-secret.mjs",
    "ops:security-rpc-smoke": "node scripts/security-rpc-smoke.mjs",
    "db:lint": "npx supabase db lint",
    "db:types": "npx supabase gen types typescript --linked > src/integrations/supabase/types.ts",
    "ops:check-edge-env": "node scripts/check-edge-env.mjs --require-prod",
    "perf:lighthouse": "node scripts/lighthouse-authenticated.mjs",
    "ops:resilience-health": "node scripts/resilience-health-check.mjs",
    "ops:diagnosis-health": "node scripts/diagnosis-health-check.mjs",
    "ops:diagnosis-secrets": "node scripts/ops-set-diagnosis-secrets.mjs",
    "ops:deploy-worker": "node scripts/deploy-worker-with-env.mjs",
    "ops:reprocess-diagnosis": "node scripts/ops-reprocess-diagnosis.mjs",
    "ops:fetch-cron-secret": "node scripts/ops-fetch-cron-secret.mjs",
    "ops:set-cron-batch": "node scripts/ops-set-cron-client-batch.mjs",
    "landing:assets": "node scripts/generate-landing-assets.mjs",
    "landing:from-png": "node scripts/process-landing-screenshots.mjs ./landing-raw-png",
    "diag:dev": "npm --prefix diagnostico-meta run dev",
    "diag:build": "npm --prefix diagnostico-meta run build",
    "diag:lint": "npm --prefix diagnostico-meta run lint",
    "diag:test": "npm --prefix diagnostico-meta run test"
  },
