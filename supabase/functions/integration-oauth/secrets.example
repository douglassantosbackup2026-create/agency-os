# Secrets para Edge Function `integration-oauth` (Supabase Dashboard → Edge Functions → Secrets,
# ou `npx supabase secrets set --project-ref <ref> KEY=value`).
#
# INTEGRATION_OAUTH_STATE_SECRET — obrigatório (≥16 caracteres). Ex.: openssl rand -hex 32
INTEGRATION_OAUTH_STATE_SECRET=

# URL público da app (redirect OAuth → {SITE}/integrations/oauth/callback)
PUBLIC_SITE_URL=
SITE_URL=

# Meta Ads
META_APP_ID=
META_APP_SECRET=

# Google Ads / GA4
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# TikTok Ads
TIKTOK_CLIENT_KEY=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_CLIENT_SECRET=
